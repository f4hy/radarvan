{
  "name": "generals-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for Radarvan — a stats tracker for Command & Conquer: Generals Zero Hour.",
  "author": "Brendan Fahy",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/f4hy/radarvan"
  },
  "dependencies": {
    "@emotion/react": "^11.8.1",
    "@emotion/styled": "^11.8.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/lodash": "^4.14.181",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "html2canvas": "^1.4.1",
    "lodash": "^4.17.21",
    "react": "^19.2.7",
    "react-activity-calendar": "^3.1.1",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi-ts": "openapi-ts",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "baseline-browser-mapping": "^2.10.42",
    "eslint": "^10.6.0",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "protoc-gen-ts": "^0.8.7",
    "ts-proto": "^2.7.7",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
