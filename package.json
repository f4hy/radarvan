{
  "name": "generals-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for Radarvan — a stats tracker for Command & Conquer: Generals Zero Hour.",
  "author": "Brendan Fahy",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/f4hy/radarvan"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@tanstack/react-query": "^5.104.2",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dayjs": "^1.11.23",
    "html2canvas": "^1.4.1",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "format": "biome format --write src/ e2e/ playwright.config.ts",
    "format:check": "biome format src/ e2e/ playwright.config.ts",
    "lint": "biome lint src/ e2e/ playwright.config.ts",
    "lint:fix": "biome lint --write src/ e2e/ playwright.config.ts",
    "test:e2e": "playwright test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "baseline-browser-mapping": "^2.11.28",
    "jsdom": "^30.1.2",
    "oxc-transform-react": "^0.152.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
