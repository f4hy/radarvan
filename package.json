{
  "name": "generals-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for Radarvan — a stats tracker for Command & Conquer: Generals Zero Hour.",
  "author": "Brendan Fahy",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/f4hy/radarvan"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dayjs": "^1.11.23",
    "html2canvas": "^1.4.1",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-router": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "openapi-ts": "openapi-ts",
    "format": "biome format --write src/ e2e/ playwright.config.ts",
    "format:check": "biome format src/ e2e/ playwright.config.ts",
    "lint": "biome lint src/ e2e/ playwright.config.ts",
    "lint:fix": "biome lint --write src/ e2e/ playwright.config.ts",
    "test:e2e": "playwright test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "baseline-browser-mapping": "^2.11.21",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
