# Radarvan environment variables
#
# Copy this file to `.env` and fill in real values for your setup.
# This file contains PLACEHOLDERS only -- never commit real secrets.
# Only variables actually read by the backend are listed here.

# --- Database (required) -------------------------------------------------
# SQLAlchemy/PostgreSQL connection string. The app fails to start without it.
# Used when running the backend by hand; the docker compose stack overrides it
# to point at its own Postgres container (see LOCAL_DEV.md).
DATABASE_URL=postgresql://user:password@localhost:5432/radarvan

# --- Local dev stack (docker compose, optional) --------------------------
# Host ports. Defaults match the by-hand workflow, so pick different ones here
# if you want the compose stack to coexist with a manual fastapi/npm run.
API_PORT=8000
WEB_PORT=5173
DB_PORT=5433
# Source database for `make db-snapshot`. Falls back to DATABASE_URL above,
# then to `heroku config:get DATABASE_URL -a $HEROKU_APP`.
PROD_DATABASE_URL=
# The compose backend runs with NOTIFY_WEB_HOOK empty so local work can't post
# to the team's Discord. Set this only when testing notify() itself.
LOCAL_NOTIFY_WEB_HOOK=

# --- Runtime mode --------------------------------------------------------
# Set to any value to enable development mode (disables scheduled scraping).
# Leave unset in production.
DEV=1

# --- Sessions & auth -----------------------------------------------------
# Secret used to sign session cookies. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">

# URL the frontend is served from (used for OAuth redirects). Defaults to "/".
FRONTEND_URL=/

# Comma-separated API keys, by privilege tier. Empty = none (which disables
# API-key auth entirely). NORMAL reaches every route the app itself uses,
# including replay upload; ADMIN additionally reaches the operational routes
# (reparse, backfill, override, delete, recompute) and implies NORMAL.
# The old API_KEY_READ / API_KEY_WRITE names are still read as a fallback.
API_KEY_NORMAL=
API_KEY_ADMIN=

# Set to any value to enforce authentication on protected routes.
ENFORCE_AUTH=

# --- Discord OAuth -------------------------------------------------------
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Discord scheduled events (bracket match scheduling) -----------------
# A bot (not the OAuth app above) invited to the server with "Manage
# Events" permission. All three required together - see discord_events.py.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_VOICE_CHANNEL_ID=your-discord-voice-channel-id

# --- cncstats integration ------------------------------------------------
# Bearer token for the cncstats parse API.
CNCSTATS_APIKEY=your-cncstats-bearer-token
# API key for registering maps with cncstats (POST /add_map).
CNCSTATS_API_KEY=your-cncstats-map-api-key

# --- Notifications -------------------------------------------------------
# Webhook URL for match notifications (e.g. Discord webhook). Optional.
NOTIFY_WEB_HOOK=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# --- Rate limiting (optional) --------------------------------------------
# Requests allowed per minute per client (default: 1200).
RATE_LIMIT_PER_MINUTE=1200
# Max random jitter, in seconds, added to 429 retry hints (default: 5).
RATE_LIMIT_RETRY_JITTER=5

# --- Native binaries (optional) ------------------------------------------
# Path to the map-parsing binary (default: ./mapparse).
MAPPARSE_BIN=./mapparse

# --- ML match-prediction model (optional) --------------------------------
# Dir containing the N-model ONNX ensemble (model-*.onnx) + shared vocab.json.
# See ml/bootstrap_matrix.py.
ML_ENSEMBLE_DIR=ml_ensemble

# --- Tracing (optional) ---------------------------------------------------
# OpenTelemetry tracing (FastAPI + httpx) is a no-op unless this is set.
# Point it at an OTLP HTTP collector (Honeycomb, Grafana Cloud, a local
# otel-collector, ...).
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-collector:4318
# Comma-separated key=value pairs, e.g. auth headers some backends require.
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-api-key
# Service name reported on spans (default: radarvan).
OTEL_SERVICE_NAME=radarvan

# --- AWS / S3 (required at runtime) --------------------------------------
# Replays and parsed JSON live in S3 (s3://generals-stats/radarvan/dev/).
# These are NOT read by the app directly -- they are consumed by boto3/fsspec
# from the standard credential chain. Set them here or via ~/.aws/credentials.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# -- CLAUDE --
CLAUDE_API_KEY=fake-fake-fake

# -- GEMINI --
GEMINI_API_KEY=fake-fake-fake
# Which LLM provider generates matchup commentary: "anthropic" or "gemini".
# Defaults to "gemini" (see radarvan/commentary/matchup_commentary.py).
COMMENTARY_PROVIDER=gemini
